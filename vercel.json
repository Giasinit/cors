{ 
  "functions": {
    "api/bombardier.go": {
      "maxDuration": 30
    },
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{certificates/*.pem,data/*.json.gz}"
    }
  },
  "rewrites": [
    { "source": "/gettrain", "has": [{ "type": "query", "key": "transport", "value": "bombardier" }], "destination": "/api/bombardier?collector=1" },
    { "source": "/get-train", "has": [{ "type": "query", "key": "transport", "value": "bombardier" }], "destination": "/api/bombardier?collector=1" },
    { "source": "/gettrain-go/schedule", "destination": "/api/bombardier?collector=1&mode=schedule" },
    { "source": "/gettrain-go", "destination": "/api/bombardier?collector=1" },
    { "source": "/bombardier", "destination": "/api/bombardier" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
